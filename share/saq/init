#!/bin/busybox sh
# /init of the Faseela installed-system initramfs.
#
# Runs with BusyBox ash only. It loads the storage modules listed in
# /etc/modules, finds and mounts the root filesystem named by root= and hands
# over to the real init with switch_root. Nothing here may depend on files that
# live outside the initramfs.
#
# Kernel command line understood:
#   root=/dev/XXX | UUID=.. | LABEL=.. | PARTUUID=.. | PARTLABEL=..
#   rootfstype=FS    rootflags=OPTS    ro | rw (default ro)
#   rootwait         wait forever for the root device
#   rootdelay=N      wait at most N seconds (default 30)
#   init=PATH        init to start in the new root (default /usr/bin/runit)
#   break[=STAGE]    open a shell before mounting root (STAGE: premount, the
#                    default) or after mounting it (STAGE: postmount)
#   quiet            suppress progress messages

PATH=/bin
export PATH

QUIET=0

say() { [ "$QUIET" = 1 ] || echo "saq: $*"; }
err() { echo "saq: $*" >&2; }

rescue() {
    err "$*"
    err "dropping to a rescue shell; 'exit' will panic the kernel"
    exec sh
}

mkdir -p /dev /proc /sys /run /newroot

mount -t proc proc /proc || rescue "cannot mount /proc"
mount -t sysfs sysfs /sys || rescue "cannot mount /sys"
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
    [ -e /dev/console ] || mknod /dev/console c 5 1
fi

# ---- kernel command line ------------------------------------------------
ROOT_SPEC=""
ROOT_FSTYPE=""
ROOT_FLAGS=""
ROOT_MODE="ro"
WAIT_LIMIT=30
WAIT_FOREVER=0
INIT_ARG=""
BREAK=""

set -f # a '*' on the command line must not be glob-expanded below
# shellcheck disable=SC2013 # splitting into words is exactly what we want
for arg in $(cat /proc/cmdline); do
    case "$arg" in
    root=*) ROOT_SPEC="${arg#root=}" ;;
    rootfstype=*) ROOT_FSTYPE="${arg#rootfstype=}" ;;
    rootflags=*) ROOT_FLAGS="${arg#rootflags=}" ;;
    rootwait) WAIT_FOREVER=1 ;;
    rootdelay=*) WAIT_LIMIT="${arg#rootdelay=}" ;;
    init=*) INIT_ARG="${arg#init=}" ;;
    break) BREAK="premount" ;;
    break=*) BREAK="${arg#break=}" ;;
    quiet) QUIET=1 ;;
    ro) ROOT_MODE="ro" ;;
    rw) ROOT_MODE="rw" ;;
    esac
done
set +f

case "$WAIT_LIMIT" in
'' | *[!0-9]*) WAIT_LIMIT=30 ;;
esac

maybe_break() {
    [ "$BREAK" = "$1" ] || return 0
    say "break=$1: opening a shell, 'exit' to continue booting"
    sh
}

# ---- storage modules ----------------------------------------------------
# /etc/modules is generated by saq and lists only modules that
# really are inside this image, so a missing entry here is not an error.
if [ -r /etc/modules ]; then
    say "loading storage modules"
    while read -r module; do
        case "$module" in
        '' | '#'*) continue ;;
        esac
        modprobe -q "$module" 2>/dev/null || true
    done </etc/modules
fi

maybe_break premount

# ---- root device --------------------------------------------------------
[ -n "$ROOT_SPEC" ] || rescue "no root= on the kernel command line"

resolve_root() {
    case "$ROOT_SPEC" in
    /dev/*)
        [ -b "$ROOT_SPEC" ] || return 1
        echo "$ROOT_SPEC"
        ;;
    UUID=* | LABEL=* | PARTUUID=* | PARTLABEL=*)
        findfs "$ROOT_SPEC" 2>/dev/null
        ;;
    *)
        return 1
        ;;
    esac
}

say "waiting for root device ($ROOT_SPEC)"
tries=0
mounted=0
while :; do
    rootdev="$(resolve_root || true)"
    if [ -n "$rootdev" ]; then
        set -- -o "$ROOT_MODE${ROOT_FLAGS:+,$ROOT_FLAGS}"
        [ -z "$ROOT_FSTYPE" ] || set -- -t "$ROOT_FSTYPE" "$@"
        if mount "$@" "$rootdev" /newroot 2>/dev/null; then
            mounted=1
            break
        fi
    fi
    tries=$((tries + 1))
    if [ "$WAIT_FOREVER" != 1 ] && [ "$tries" -ge "$WAIT_LIMIT" ]; then
        break
    fi
    sleep 1
done

if [ "$mounted" != 1 ]; then
    err "could not mount root ($ROOT_SPEC)"
    err "block devices the kernel knows about:"
    cat /proc/partitions >&2
    case "$ROOT_SPEC" in
    PARTUUID=* | PARTLABEL=*)
        err "BusyBox may not resolve $ROOT_SPEC; try root=UUID=... instead"
        ;;
    esac
    rescue "root filesystem not available"
fi

maybe_break postmount

# ---- hand over ----------------------------------------------------------
NEW_INIT=""
for candidate in "$INIT_ARG" /usr/bin/runit /sbin/init /usr/sbin/init; do
    [ -n "$candidate" ] || continue
    if [ -x "/newroot$candidate" ]; then
        NEW_INIT="$candidate"
        break
    fi
done
[ -n "$NEW_INIT" ] || rescue "no init found in the new root (tried ${INIT_ARG:+$INIT_ARG }/usr/bin/runit /sbin/init /usr/sbin/init)"

mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run 2>/dev/null || true
mount -o move /dev /newroot/dev || rescue "cannot move /dev"
mount -o move /proc /newroot/proc || rescue "cannot move /proc"
mount -o move /sys /newroot/sys || rescue "cannot move /sys"

say "switching to $NEW_INIT"
# switch_root only works as PID 1, so it has to replace this shell. If exec
# itself fails the script ends and the kernel panics with a clear message.
exec switch_root -c /dev/console /newroot "$NEW_INIT"
